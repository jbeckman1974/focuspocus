{
  "name": "focuspocus-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort",
    "build": "vite build",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src tests",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
